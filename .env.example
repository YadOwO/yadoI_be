# ---- 服务 ----
PORT=3000
NODE_ENV=development

# ---- 数据库 ----
# 本地开发可直接用 docker-compose.yml 起的 Postgres
# 本产品的表统一位于 yadoi schema 下（schema 名在代码中固定，见 src/db/schema.ts）
DATABASE_URL=postgres://yado:yado@localhost:5432/yado

# ---- 认证（Logto）----
# Logto 的 issuer，形如 https://auth.yado.com/oidc
LOGTO_ISSUER=http://localhost:3001/oidc
# 本服务在 Logto 中注册的 API resource indicator，作为 JWT 的 audience 校验
LOGTO_AUDIENCE=https://api.yado.com/yadoi
# JWKS 地址，留空时自动推导为 ${LOGTO_ISSUER}/jwks
# LOGTO_JWKS_URL=

# 本地开发绕过 JWT 校验，用固定用户身份调试；NODE_ENV=production 时该配置强制失效
AUTH_DEV_BYPASS=false
AUTH_DEV_USER_ID=dev-user-0001

# ---- 跨域 ----
# 逗号分隔的允许来源；生产环境务必改为具体域名，例如 https://i.yado.com
CORS_ORIGINS=*
